OPENAI_API_KEY=
# Optional model overrides:
# OPENAI_TUTOR_MODEL=gpt-4.1-mini
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Supabase project settings. Use the publishable/anon key only in the browser.
# Never put a Supabase secret/service_role key in this file or expose it to users.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Older Supabase projects may label this key anon instead:
# SUPABASE_ANON_KEY=

# Supabase Auth SMTP via Resend; required only when pushing SMTP settings with the Supabase CLI.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
